APP_ENV=development

# Ollama LLM Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///./data/nyra.db

# Personality & Identity Settings
NYRA_NAME=Nyra
OWNER_NAME=Rafey

# Telephony Configuration (sip [default free local] | exotel [optional PSTN] | android)
TELEPHONY_PROVIDER=sip

# Local SIP Server / PBX Settings (Free local telephony)
SIP_SERVER_HOST=192.168.1.100
SIP_SERVER_PORT=5060
SIP_EXTENSION=1001
SIP_PASSWORD=change_this_password
SIP_MEDIA_ENCODING=audio/mulaw
SIP_MEDIA_SAMPLE_RATE=8000

# Optional PSTN Provider (Exotel)
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_VIRTUAL_NUMBER=your_exotel_virtual_number
EXOTEL_MEDIA_ENCODING=audio/pcm
EXOTEL_MEDIA_SAMPLE_RATE=16000
TELEPHONY_WEBHOOK_TOKEN=your_secret_telephony_webhook_token

# WhatsApp Configuration (mock | cloud_api)
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_RECIPIENT_NUMBER=

# Network / Tunnel
PUBLIC_BASE_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO
